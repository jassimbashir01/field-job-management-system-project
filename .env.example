# ─── Application ────────────────────────────────────────────────────────────
# Public base URL of this deployment, no trailing slash. Used for absolute
# links in emails, quote/invoice pages, and the PWA manifest.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Deployment target for local dev only. One of: "node" | "cloudflare"
# Leave as "node" unless actively testing a Cloudflare build locally.
DEPLOY_TARGET="node"

DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── File storage ───────────────────────────────────────────────────────────
# "db" (default): files stored directly in Postgres — zero config, zero
# cost, fine for local dev and the portfolio demo. "s3": any S3-compatible
# bucket (Cloudflare R2, AWS S3, Backblaze B2). Leave as "db" unless you
# actually have a bucket to point this at.
STORAGE_DRIVER="db"

# Only read when STORAGE_DRIVER="s3" — leave commented out otherwise.
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="field-job-management-system"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""