# ─── Application ────────────────────────────────────────────────────────────
# Public base URL of this deployment, no trailing slash. Used for absolute
# links in emails, quote/invoice pages, and the PWA manifest.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Deployment target for local dev only. One of: "node" | "cloudflare"
# Leave as "node" unless actively testing a Cloudflare build locally.
DEPLOY_TARGET="node"

DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"